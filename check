#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

command -v dart >/dev/null 2>&1 || { echo "dart was not found in PATH" >&2; exit 127; }

echo "==> Application dependencies"
dart pub get

echo "==> Static analysis"
dart analyze lib tool test

echo "==> Student API package"
(
  cd packages/sorting_sandbox_api
  dart pub get
  dart analyze
  dart test
)

echo "==> Runtime and instrumentation tests"
dart run test/runtime_test.dart
dart run test/instrumenter_test.dart
dart run test/inspect_test.dart

echo "==> End-to-end: build and run the templates in real worker processes"
dart run test/smoke_test.dart

python=""
for candidate in "${SANDBOX_PYTHON:-}" python3 python; do
  if [[ -n "$candidate" ]] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    python="$candidate"
    break
  fi
done
if [[ -n "$python" ]]; then
  echo "==> Python worker, checks and formatter"
  "$python" -I -B test/python_worker_test.py
else
  echo "(no Python 3.10+ found: skipping the Python worker tests)"
fi

java_bin="${SANDBOX_JAVA_HOME:-${JAVA_HOME:-}}"
java_bin="${java_bin:+$java_bin/bin/}"
javac_version="$("${java_bin}javac" -version 2>&1 || true)"
if grep -q -E 'javac (1[7-9]|[2-9][0-9])' <<< "$javac_version"; then
  echo "==> Java worker, instrumenter, checks and formatter"
  # JDK 17 reads source files in the locale's encoding; the test file is UTF-8.
  "${java_bin}java" -Dfile.encoding=UTF-8 test/JavaWorkerTest.java
else
  echo "(no JDK 17+ found: skipping the Java worker tests)"
fi

echo "==> new-algorithm (language choice)"
bash test/new_algorithm.test.sh

echo "==> ./run without a Dart SDK (precompiled app)"
bash test/precompiled_run.test.sh

if command -v node >/dev/null 2>&1; then
  echo "==> Browser helper and JavaScript worker tests"
  for t in test/*.test.mjs; do node "$t"; done
else
  echo "(node not found: skipping browser helper and JavaScript worker tests)"
fi

echo "✓ All checks passed"
