#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

command -v dart >/dev/null 2>&1 || { echo "dart was not found in PATH" >&2; exit 127; }

echo "==> Application dependencies"
dart pub get

echo "==> Static analysis"
dart analyze lib tool test

echo "==> Student API package"
(
  cd packages/sorting_sandbox_api
  dart pub get
  dart analyze
  dart test
)

echo "==> Runtime and instrumentation tests"
dart run test/runtime_test.dart
dart run test/instrumenter_test.dart
dart run test/inspect_test.dart

echo "==> End-to-end: build and run the templates in real worker processes"
dart run test/smoke_test.dart

python=""
for candidate in "${SANDBOX_PYTHON:-}" python3 python; do
  if [[ -n "$candidate" ]] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    python="$candidate"
    break
  fi
done
if [[ -n "$python" ]]; then
  echo "==> Python worker, checks and formatter"
  "$python" -I -B test/python_worker_test.py
else
  echo "(no Python 3.10+ found: skipping the Python worker tests)"
fi

if command -v node >/dev/null 2>&1; then
  echo "==> Browser helper tests"
  for t in test/*.test.mjs; do node "$t"; done
else
  echo "(node not found: skipping browser helper tests)"
fi

echo "✓ All checks passed"
