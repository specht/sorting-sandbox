.dart_tool/
.packages
.pub/
build/

# The class algorithm repository is a separate nested Git repository.
/algorithms/

# Generated classroom runtime. The static Flutter app never imports student code.
/runtime/*
!/runtime/.gitkeep

worker/generated/*
!worker/generated/.gitkeep
!worker/generated/registry.g.dart
worker/generated_next/
worker/main_next.dart

# Native algorithm snapshot embedded by ./build-apk.
lib/generated/*
!lib/generated/catalog.g.dart
!lib/generated/registry.g.dart
lib/generated_next/

# The Android host is regenerated from the installed Flutter SDK by ./build-apk.
/android/
